{
  "$comment": "显示行业公开信源，首次启动导入；奥维公开详情解析原文链接或内嵌正文，日期按北京时间处理。站内与RSS全文默认关闭。",
  "sources": [
    {
      "id": "web-trendforce-display",
      "name": "TrendForce 集邦咨询 · 显示面板",
      "kind": "web_list",
      "config": {
        "url": "https://www.trendforce.cn/presscenter/news/Display",
        "itemSelector": ".list-items .list-item",
        "linkSelector": "h3 a.title-link",
        "titleSelector": "h3",
        "publishedAtSelector": "h4",
        "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": [
          "https://www.trendforce.cn/presscenter/news/20"
        ],
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "trendforce",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": [
        "显示行业",
        "研究机构"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-trendforce-led",
