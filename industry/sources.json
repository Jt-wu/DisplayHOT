    {
      "id": "json-avc-display",
      "name": "奥维云网 / 奥维睿沃 · 公开资讯",
      "kind": "json_list",
      "config": {
        "url": "https://newcompassback.avc-mr.com/applet/user/avc-information/info/list?term=90",
        "itemsPath": "data",
        "titlePaths": [
          "title"
        ],
        "authorPaths": [
          "author"
        ],
        "publishedAtPath": "createTime",
        "externalIdPath": "id",
        "urlTemplate": "{raw:articleUrl}",
        "fetchPublicContent": true,
        "ingestNoiseFilter": {
          "dropMarkers": [
            ""
          ],
          "keepIfMatches": [
            "显示",
            "面板",
            "oled",
            "mini-led",
            "mini led",
            "microled",
            "micro led",
            "电视",
            "彩电",
            "tv面板",
            "mnt",
            "mini‑led",
            "micro-led",
            "mini led"
          ]
        },
        "_aihot": {
          "initialBackfillLimit": 12
        },
        "mode": "avc_public",
        "publishedAtUtcOffset": "+08:00",
        "summaryPaths": [
          "content"
        ],
        "summaryIsBody": true
      },
      "tier": "T1",
      "first_party": true,
      "owner_entity_id": "avc",
      "participation_mode": "editorial",
      "interval_minutes": 180,
      "tags": [
        "显示行业",
        "研究机构"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "rss-oled-info",
      "name": "OLED-Info",
      "kind": "rss",
